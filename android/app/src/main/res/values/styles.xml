<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is dark in both OS modes, so both variants use the same
         near-black. A light launch window produced a white flash before the
         first Flutter frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ny_wallpaper</item>
    </style>
</resources>

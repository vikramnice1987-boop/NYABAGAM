# NYABAGAM Firebase / Google Cloud environment variables
#
# Prefer: flutterfire configure.
# It generates lib/firebase_options.dart from Firebase project settings.
# These Dart defines are a development-safe alternative used by this repo's
# placeholder options file; never put service-account credentials or an OpenAI
# key in this file.
FIREBASE_API_KEY=your-web-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_EMAIL_LINK_URL=https://your-project-id.firebaseapp.com/finishSignIn
FIREBASE_FUNCTIONS_REGION=asia-south1
FIREBASE_AI_FUNCTION_NAME=aiOrchestrator
